{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(herdr agent prompt:*)",
      "Bash(herdr agent list:*)",
      "Bash(herdr agent get:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(diff:*)",
