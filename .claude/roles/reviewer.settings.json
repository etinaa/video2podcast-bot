      "Edit(./pom.xml)",
      "Edit(./config/**)",
      "Edit(./deploy/**)",
      "Edit(./docs/**)",
      "Edit(./scripts/**)",
      "Edit(./tasks/*/*.md)",
      "Edit(./tasks/*/comms/questions.md)",
      "Edit(./tasks/*/comms/approvals.md)",
