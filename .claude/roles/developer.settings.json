{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(herdr agent prompt:*)",
      "Bash(herdr agent list:*)",
      "Bash(herdr agent get:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(mkdir -p:*)",
      "Bash(./mvnw:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cp target/pit-reports/*)",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Bash(sed -i*CLAUDE.md*)",
      "Edit(./tasks/todo.md)",
      "Edit(./src/it/**)",
      "Edit(./src/features/**)",
      "Edit(./tasks/plan.md)",
      "Edit(./tasks/*/*.md)",
      "Edit(./tasks/*/review/**)",
      "Edit(./docs/decisions.md)",
      "Edit(./docs/architecture/**)"
    ]
  }
}
