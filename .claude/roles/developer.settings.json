      "Write(./tasks/todo.md)",
      "Edit(./src/it/**)",
      "Write(./src/it/**)",
      "Edit(./src/features/**)",
      "Write(./src/features/**)",
      "Edit(./tasks/**)",
      "Write(./tasks/**)",
      "Edit(./docs/decisions.md)",
