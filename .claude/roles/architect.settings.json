{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(herdr agent prompt:*)",
      "Bash(herdr agent list:*)",
      "Bash(herdr agent get:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(mkdir -p:*)",
      "Bash(curl -s -m 15 https://repo1.maven.org/maven2/*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./tasks/todo.md)",
      "Edit(./src/**)",
      "Edit(./pom.xml)",
      "Edit(./config/**)",
      "Edit(./deploy/**)",
      "Bash(./mvnw:*)"
    ]
  }
}
