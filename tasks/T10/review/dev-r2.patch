@@ -0,0 +1,31 @@
+package com.video2podcast.summary;
+
+/** The system prompts. Every one asks for English, whatever the language of the input. */
+final class Prompts {
+
+  static final String SHORT =
+      "You summarize a video transcript. Write the final summary as English bullet points, even if"
+          + " the transcript is not in English. Start every line with \"- \". Use at most 8"
+          + " bullets and keep each bullet short. Answer with the bullet points only, without a"
+          + " preamble.";
+
+  static final String MAP =
+      "You summarize one part of a longer video transcript. List the key points of this part as"
+          + " English bullet points, even if the text is not in English. Start every line with"
+          + " \"- \". Use 3 to 8 bullets. Answer with the bullet points only, without a"
+          + " preamble.";
+
+  static final String REDUCE_FINAL =
+      "You are given bullet-point summaries of consecutive parts of one video transcript. Write"
+          + " the final summary of the whole video as English bullet points, even if the input is"
+          + " not in English. Start every line with \"- \". Use at most 8 bullets and keep each"
+          + " bullet short. Answer with the bullet points only, without a preamble.";
+
+  static final String REDUCE_ROUND =
+      "You are given bullet-point summaries of consecutive parts of one video transcript. Merge"
+          + " them into one shorter English bullet list that keeps the important points, even if"
+          + " the input is not in English. Start every line with \"- \". Answer with the bullet"
+          + " points only, without a preamble.";
+
+  private Prompts() {}
+}
diff --git a/src/main/java/com/video2podcast/summary/SummaryFormatter.java b/src/main/java/com/video2podcast/summary/SummaryFormatter.java
new file mode 100644
index 0000000..19db8a8
--- /dev/null
+++ b/src/main/java/com/video2podcast/summary/SummaryFormatter.java
@@ -0,0 +1,71 @@
+package com.video2podcast.summary;
+
+import com.video2podcast.job.JobFailure;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Shapes model answers: bounds intermediate ones and turns the final one into capped bullets. */
+final class SummaryFormatter {
+
+  static final int SUMMARY_CAP = 1500;
+  private static final String MARKERS = "-*•–";
+  private static final String ELLIPSIS = "…";
+
+  private SummaryFormatter() {}
+
+  /**
+   * Keeps {@code content} within {@code maxChars}: whole trailing lines are dropped, then a single
+   * remaining line is cut. Nothing else is changed.
+   */
+  static String clip(String content, int maxChars) {
+    if (content.length() <= maxChars) {
+      return content;
+    }
+    List<String> lines = new ArrayList<>(List.of(content.split("\\R")));
+    String joined = String.join("\n", lines);
+    while (joined.length() > maxChars && lines.size() > 1) {
+      lines.remove(lines.size() - 1);
+      joined = String.join("\n", lines);
+    }
+    return joined.length() > maxChars ? cut(joined, maxChars) : joined;
+  }
+
+  /** The final answer: {@code "• "} lines, at most {@link #SUMMARY_CAP} UTF-16 units. */
+  static String format(String content) {
+    List<String> bullets = new ArrayList<>();
+    for (String raw : content.split("\\R")) {
+      String line = withoutMarker(raw.strip());
+      if (!line.isEmpty()) {
+        bullets.add("• " + line);
+      }
+    }
+    if (bullets.isEmpty()) {
+      throw JobFailure.summaryFailed(null);
+    }
+    String joined = String.join("\n", bullets);
+    while (joined.length() > SUMMARY_CAP && bullets.size() > 1) {
+      bullets.remove(bullets.size() - 1);
+      joined = String.join("\n", bullets);
+    }
+    return joined.length() > SUMMARY_CAP ? cut(joined, SUMMARY_CAP - 1) + ELLIPSIS : joined;
+  }
+
+  /** A line of just one marker is empty; a marker is only a marker before whitespace. */
+  private static String withoutMarker(String line) {
+    if (line.isEmpty() || MARKERS.indexOf(line.charAt(0)) < 0) {
+      return line;
+    }
+    if (line.length() == 1) {
+      return "";
+    }
+    return Character.isWhitespace(line.charAt(1)) ? line.substring(1).strip() : line;
+  }
+
+  /** The first {@code max} chars, one less when the cut would split a surrogate pair. */
+  private static String cut(String text, int max) {
+    boolean splitsPair =
+        Character.isHighSurrogate(text.charAt(max - 1))
+            && Character.isLowSurrogate(text.charAt(max));
+    return text.substring(0, splitsPair ? max - 1 : max);
+  }
+}
diff --git a/src/main/java/com/video2podcast/summary/SummaryService.java b/src/main/java/com/video2podcast/summary/SummaryService.java
new file mode 100644
index 0000000..ae5b586
--- /dev/null
+++ b/src/main/java/com/video2podcast/summary/SummaryService.java
@@ -0,0 +1,158 @@
+package com.video2podcast.summary;
+
+import com.video2podcast.config.AppProperties;
+import com.video2podcast.job.JobFailure;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Summarizes a transcript: one request when it fits the context, otherwise map and reduce. */
+public final class SummaryService {
+
+  private static final Logger LOG = LoggerFactory.getLogger(SummaryService.class);
+
+  static final int OUTPUT_RESERVE = 1024;
+  static final double MIN_RATIO = 0.5;
+  static final int MAX_ROUNDS = 8;
+
+  private static final String SEPARATOR = "\n\n";
+
+  private final LlmClient llm;
+  private final int maxChunkChars;
+  private final int partialMaxChars;
+  private final int maxRounds;
+
+  public SummaryService(LlmClient llm, AppProperties.Ollama config) {
+    this(llm, config, MAX_ROUNDS);
+  }
+
+  /** For tests: the round limit is supplied. */
+  SummaryService(LlmClient llm, AppProperties.Ollama config, int maxRounds) {
+    if (config.numCtx() <= 0) {
+      throw new IllegalArgumentException("app.ollama.num-ctx must be positive");
+    }
+    int promptTokens =
+        Math.max(
+            Math.max(TokenEstimator.estimate(Prompts.SHORT), TokenEstimator.estimate(Prompts.MAP)),
+            Math.max(
+                TokenEstimator.estimate(Prompts.REDUCE_FINAL),
+                TokenEstimator.estimate(Prompts.REDUCE_ROUND)));
+    long textBudget =
+        (long) config.numCtx() - OUTPUT_RESERVE - promptTokens - TokenEstimator.TEMPLATE_OVERHEAD;
+    if (textBudget < 2L * OUTPUT_RESERVE) {
+      throw new IllegalArgumentException("app.ollama.num-ctx is too small: " + config.numCtx());
+    }
+    if (textBudget > Integer.MAX_VALUE / TokenEstimator.CHARS_PER_TOKEN) {
+      throw new IllegalArgumentException("app.ollama.num-ctx is too large: " + config.numCtx());
+    }
+    this.llm = llm;
+    this.maxRounds = maxRounds;
+    this.maxChunkChars = (int) (textBudget * TokenEstimator.CHARS_PER_TOKEN);
+    this.partialMaxChars = (maxChunkChars - 3 * SEPARATOR.length()) / 4;
+  }
+
+  /** Characters of user text that fit one request. */
+  int maxChunkChars() {
+    return maxChunkChars;
+  }
+
+  /** The bound for every intermediate answer. */
+  int partialMaxChars() {
+    return partialMaxChars;
+  }
+
+  /**
+   * Returns English bullet text, {@code "• "} per line, at most 1,500 UTF-16 chars, never blank.
+   *
+   * @throws NullPointerException if {@code transcript} is null
+   * @throws JobFailure when the summary server is unreachable, too slow, or its answer is unusable
+   */
+  public String summarize(String transcript) {
+    String text = Objects.requireNonNull(transcript, "transcript").strip();
+    if (text.isEmpty()) {
+      throw JobFailure.summaryFailed(null);
+    }
+    if (text.length() <= maxChunkChars) {
+      return SummaryFormatter.format(call(Prompts.SHORT, text));
+    }
+    List<String> partials = new ArrayList<>();
+    for (String chunk : TextChunker.split(text, maxChunkChars)) {
+      partials.add(clipped(call(Prompts.MAP, chunk)));
+    }
+    int round = 0;
+    while (true) {
+      String joined = String.join(SEPARATOR, partials);
+      if (joined.length() <= maxChunkChars) {
+        return SummaryFormatter.format(call(Prompts.REDUCE_FINAL, joined));
+      }
+      round++;
+      if (round > maxRounds) {
+        throw JobFailure.summaryFailed(null);
+      }
+      List<String> next = new ArrayList<>();
+      for (String group : groups(partials)) {
+        next.add(clipped(call(Prompts.REDUCE_ROUND, group)));
+      }
+      partials = next;
+    }
+  }
+
+  /** Greedy, in order; each group is the partials joined by blank lines, within one request. */
+  private List<String> groups(List<String> partials) {
+    List<String> groups = new ArrayList<>();
+    StringBuilder current = new StringBuilder();
+    for (String partial : partials) {
+      if (!current.isEmpty()
+          && current.length() + SEPARATOR.length() + partial.length() > maxChunkChars) {
+        groups.add(current.toString());
+        current.setLength(0);
+      }
+      if (!current.isEmpty()) {
+        current.append(SEPARATOR);
+      }
+      current.append(partial);
+    }
+    groups.add(current.toString());
+    return groups;
+  }
+
+  private String clipped(String content) {
+    String clipped = SummaryFormatter.clip(content, partialMaxChars);
+    if (clipped.length() < content.length() && LOG.isWarnEnabled()) {
+      LOG.warn(
+          "Clipped an intermediate answer from {} to {} chars", content.length(), clipped.length());
+    }
+    return clipped;
+  }
+
+  private static JobFailure failureOf(LlmException e) {
+    return switch (e.reason()) {
+      case CONNECTION -> JobFailure.of(JobFailure.Kind.SUMMARY_UNREACHABLE, e);
+      case TIMEOUT -> JobFailure.of(JobFailure.Kind.TIMEOUT, e);
+      case OTHER -> JobFailure.summaryFailed(e);
+    };
+  }
+
+  private String call(String system, String user) {
+    LlmReply reply;
+    try {
+      reply = llm.complete(system, user, OUTPUT_RESERVE);
+    } catch (LlmException e) {
+      throw failureOf(e);
+    }
+    long expected = TokenEstimator.requestEstimate(system, user);
+    long threshold = (long) Math.ceil(expected * MIN_RATIO);
+    if (reply.promptTokens() < threshold) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn(
+            "Prompt looks truncated: {} tokens evaluated, at least {} expected",
+            reply.promptTokens(),
+            threshold);
+      }
+      throw JobFailure.summaryFailed(null);
+    }
+    return reply.content();
+  }
+}
diff --git a/src/main/java/com/video2podcast/summary/TextChunker.java b/src/main/java/com/video2podcast/summary/TextChunker.java
new file mode 100644
index 0000000..690c3aa
--- /dev/null
+++ b/src/main/java/com/video2podcast/summary/TextChunker.java
@@ -0,0 +1,45 @@
+package com.video2podcast.summary;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Splits text into ordered chunks of at most a given length, preferring to cut at whitespace. */
+final class TextChunker {
+
+  private TextChunker() {}
+
+  /**
+   * Text of at most {@code maxChars} is returned unchanged as one chunk. Otherwise every chunk is
+   * stripped and has at most {@code maxChars} chars; together they hold the text minus whitespace.
+   */
+  static List<String> split(String text, int maxChars) {
+    if (text.length() <= maxChars) {
+      return List.of(text);
+    }
+    List<String> chunks = new ArrayList<>();
+    int start = 0;
+    while (start < text.length()) {
+      int cut = text.length() - start <= maxChars ? text.length() : cutAfter(text, start, maxChars);
+      String chunk = text.substring(start, cut).strip();
+      if (!chunk.isEmpty()) {
+        chunks.add(chunk);
+      }
+      start = cut;
+    }
+    return chunks;
+  }
+
+  /** The end of the chunk that starts at {@code start}; the rest of the text is longer than it. */
+  private static int cutAfter(String text, int start, int maxChars) {
+    int limit = start + maxChars;
+    for (int i = limit; i >= start + maxChars / 2; i--) {
+      if (Character.isWhitespace(text.charAt(i))) {
+        return i + 1;
+      }
+    }
+    boolean splitsPair =
+        Character.isHighSurrogate(text.charAt(limit - 1))
+            && Character.isLowSurrogate(text.charAt(limit));
+    return splitsPair && limit - 1 > start ? limit - 1 : limit;
+  }
+}
