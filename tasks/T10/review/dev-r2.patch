new file mode 100644
index 0000000..27f2273
--- /dev/null
+++ b/src/main/java/com/video2podcast/summary/LlmException.java
@@ -0,0 +1,25 @@
+package com.video2podcast.summary;
+
+/** One call to the language model failed. The message is for logs only. */
+public class LlmException extends Exception {
+
+  private static final long serialVersionUID = 1L;
+
+  /** What kind of failure it was. */
+  public enum Reason {
+    CONNECTION,
+    TIMEOUT,
+    OTHER
+  }
+
+  private final Reason reason;
+
+  public LlmException(String message, Reason reason, Throwable cause) {
+    super(message, cause);
+    this.reason = reason;
+  }
+
+  public Reason reason() {
+    return reason;
+  }
+}
