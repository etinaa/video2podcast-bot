+        FakeProcessRunner.returning(ok("{\"title\":\"T\",\"is_live\":true,\"duration\":5}"));
+    assertThatThrownBy(() -> client(runner).fetchMetadata(URL))
+        .hasMessage("Live streams are not supported.");
