index 0000000..427b9bb
--- /dev/null
+++ b/src/main/java/com/video2podcast/job/JobFailure.java
@@ -0,0 +1,81 @@
+package com.video2podcast.job;
+
+import java.time.Duration;
+
+/**
+ * A job failed in a way the user may be told about. The message is one of a few fixed English
+ * sentences and never contains stderr, paths or the URL.
+ */
+public class JobFailure extends RuntimeException {
+
+  private static final long serialVersionUID = 1L;
+
+  /** Why the job failed. */
+  public enum Kind {
+    PRIVATE,
+    UNSUPPORTED,
+    TOO_LONG,
+    FAILED,
+    TIMEOUT
+  }
+
+  private final Kind kind;
+
+  public JobFailure(Kind kind, String safeMessage) {
+    this(kind, safeMessage, null);
+  }
+
+  /** The cause is for logs only; it is never part of the message. */
+  private JobFailure(Kind kind, String safeMessage, Throwable cause) {
+    super(safeMessage, cause);
+    this.kind = kind;
+  }
+
+  public Kind kind() {
+    return kind;
+  }
+
+  /** A failure with the fixed message of {@code kind}; {@code TOO_LONG} uses {@link #tooLong}. */
+  public static JobFailure of(Kind kind) {
+    return new JobFailure(kind, messageOf(kind));
+  }
+
+  /** Like {@link #of(Kind)}, keeping {@code cause} for the log. */
+  public static JobFailure of(Kind kind, Throwable cause) {
+    return new JobFailure(kind, messageOf(kind), cause);
+  }
+
+  public static JobFailure unsupportedLiveStream() {
+    return new JobFailure(Kind.UNSUPPORTED, "Live streams are not supported.");
+  }
+
+  public static JobFailure tooLong(Duration limit) {
+    return new JobFailure(Kind.TOO_LONG, "The video is longer than " + formatLimit(limit) + ".");
+  }
+
+  private static String messageOf(Kind kind) {
+    return switch (kind) {
+      case PRIVATE -> "This video is private or needs a sign-in.";
+      case UNSUPPORTED -> "This link is not a supported video.";
+      case TOO_LONG -> "The video is too long.";
+      case FAILED -> "Could not process this video. Please try again later.";
+      case TIMEOUT -> "Processing took too long and was stopped.";
+    };
+  }
+
+  private static String formatLimit(Duration limit) {
+    long hours = limit.toHours();
+    long minutes = limit.toMinutesPart();
+    StringBuilder text = new StringBuilder();
+    if (hours > 0) {
+      text.append(hours).append(hours == 1 ? " hour" : " hours");
+    }
+    if (minutes > 0) {
+      if (!text.isEmpty()) {
+        text.append(' ');
+      }
+      text.append(minutes).append(minutes == 1 ? " minute" : " minutes");
+    }
+    return text.isEmpty() ? "0 minutes" : text.toString();
+  }
+}
diff --git a/src/main/java/com/video2podcast/media/ChunkSplitter.java b/src/main/java/com/video2podcast/media/ChunkSplitter.java
new file mode 100644
index 0000000..db11093
--- /dev/null
+++ b/src/main/java/com/video2podcast/media/ChunkSplitter.java
@@ -0,0 +1,79 @@
+package com.video2podcast.media;
+
+import com.video2podcast.job.JobFailure;
+import java.io.IOException;
+import java.nio.file.DirectoryStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+import java.util.regex.Pattern;
+
+/** The pure part of splitting: the ffmpeg segment arguments and the list of produced chunks. */
+final class ChunkSplitter {
+
+  static final int SEGMENT_SECONDS = 600;
+
+  private static final Pattern CHUNK = Pattern.compile("chunk-\\d{3}\\.wav");
+
+  private ChunkSplitter() {}
+
+  static List<String> splitArgs(Path wav, Path chunksDir) {
+    // ffmpeg reads % in the output pattern as a format marker; %% is a literal percent sign.
+    String pattern = chunksDir.toString().replace("%", "%%") + "/chunk-%03d.wav";
+    return List.of(
+        "ffmpeg",
+        "-nostdin",
+        "-hide_banner",
+        "-loglevel",
+        "error",
+        "-y",
+        "-i",
+        wav.toString(),
+        "-f",
+        "segment",
+        "-segment_time",
+        String.valueOf(SEGMENT_SECONDS),
+        "-c",
+        "copy",
+        pattern);
+  }
+
+  /** The chunk files in {@code chunksDir}, sorted by name. */
+  static List<Path> collect(Path chunksDir) {
+    List<Path> chunks = list(chunksDir);
+    chunks.sort(Comparator.comparing(ChunkSplitter::name));
+    return chunks;
+  }
+
+  /** Deletes the chunk files left in {@code chunksDir} by an earlier run. */
+  static void deleteExisting(Path chunksDir) {
+    try {
+      for (Path stale : list(chunksDir)) {
+        Files.deleteIfExists(stale);
+      }
+    } catch (IOException e) {
+      throw JobFailure.of(JobFailure.Kind.FAILED, e);
+    }
+  }
+
+  private static String name(Path path) {
+    return Objects.toString(path.getFileName(), "");
+  }
+
+  private static List<Path> list(Path chunksDir) {
+    List<Path> found = new ArrayList<>();
+    try (DirectoryStream<Path> stream = Files.newDirectoryStream(chunksDir)) {
+      for (Path path : stream) {
+        if (CHUNK.matcher(name(path)).matches() && Files.isRegularFile(path)) {
+          found.add(path);
+        }
+      }
+    } catch (IOException e) {
+      throw JobFailure.of(JobFailure.Kind.FAILED, e);
+    }
+    return found;
+  }
+}
diff --git a/src/main/java/com/video2podcast/media/DefaultProcessRunner.java b/src/main/java/com/video2podcast/media/DefaultProcessRunner.java
new file mode 100644
index 0000000..83822be
--- /dev/null
+++ b/src/main/java/com/video2podcast/media/DefaultProcessRunner.java
@@ -0,0 +1,169 @@
+package com.video2podcast.media;
+
+import com.video2podcast.job.JobFailure;
+import java.io.ByteArrayOutputStream;
+import java.io.Closeable;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Runs a process without a shell, reads both output streams on their own threads and kills the
+ * whole process tree when the timeout ends. Nothing here waits without a bound.
+ */
+public class DefaultProcessRunner implements ProcessRunner {
+
+  static final int MAX_OUTPUT_BYTES = 8 * 1024 * 1024;
+  private static final Duration CLEANUP_BUDGET = Duration.ofSeconds(5);
+  private static final long GRACE_NANOS = TimeUnit.MILLISECONDS.toNanos(200);
+
+  /** Collects up to {@link #MAX_OUTPUT_BYTES} and keeps reading (and dropping) the rest. */
+  private static final class Reader implements Runnable {
+    private final InputStream in;
+    private final ByteArrayOutputStream buffer = new ByteArrayOutputStream();
+
+    Reader(InputStream in) {
+      this.in = in;
+    }
+
+    @Override
+    public void run() {
+      byte[] chunk = new byte[8192];
+      try {
+        int n = in.read(chunk);
+        while (n >= 0) {
+          append(chunk, n);
+          n = in.read(chunk);
+        }
+      } catch (IOException ignored) {
+        // The stream was closed under us (cleanup) or the process died: keep what we have.
+      }
+    }
+
+    private synchronized void append(byte[] data, int length) {
+      int room = MAX_OUTPUT_BYTES - buffer.size();
+      if (room > 0) {
+        buffer.write(data, 0, Math.min(room, length));
+      }
+    }
+
+    synchronized String text() {
+      return buffer.toString(StandardCharsets.UTF_8);
+    }
+  }
+
+  /** A started process; closing it closes all three of its streams. */
+  private static final class Child implements AutoCloseable {
+    private final Process process;
+
+    private Child(Process process) {
+      this.process = process;
+    }
+
+    static Child start(List<String> args) {
+      try {
+        Child child = new Child(new ProcessBuilder(args).start());
+        // Nothing is ever sent to the child; closing stdin keeps a reader from waiting on it.
+        closeQuietly(child.process.getOutputStream());
+        return child;
+      } catch (IOException e) {
+        throw JobFailure.of(JobFailure.Kind.FAILED, e);
+      }
+    }
+
+    InputStream stdout() {
+      return process.getInputStream();
+    }
+
+    InputStream stderr() {
+      return process.getErrorStream();
+    }
+
+    boolean waitFor(long nanos) throws InterruptedException {
+      return process.waitFor(nanos, TimeUnit.NANOSECONDS);
+    }
+
+    int exitCode() {
+      return process.exitValue();
+    }
+
+    void killTree() {
+      List<ProcessHandle> descendants = process.descendants().toList();
+      descendants.forEach(ProcessHandle::destroyForcibly);
+      process.destroyForcibly();
+    }
+
+    @Override
+    public void close() {
+      closeQuietly(process.getInputStream());
+      closeQuietly(process.getErrorStream());
+      closeQuietly(process.getOutputStream());
+    }
+  }
+
+  @Override
+  public ProcessResult run(List<String> args, Duration timeout) {
+    if (timeout == null || timeout.isZero() || timeout.isNegative()) {
+      throw new IllegalArgumentException("timeout must be positive");
+    }
+    try (Child child = Child.start(args)) {
+      Reader out = new Reader(child.stdout());
+      Reader err = new Reader(child.stderr());
+      Thread outThread = daemon(out, "process-stdout");
+      Thread errThread = daemon(err, "process-stderr");
+      outThread.start();
+      errThread.start();
+      try {
+        if (!child.waitFor(timeout.toNanos())) {
+          killAndCleanUp(child, outThread, errThread);
+          throw JobFailure.of(JobFailure.Kind.TIMEOUT);
+        }
+        long deadline = System.nanoTime() + CLEANUP_BUDGET.toNanos();
+        join(outThread, deadline);
+        join(errThread, deadline);
+        child.close();
+        join(outThread, System.nanoTime() + GRACE_NANOS);
+        join(errThread, System.nanoTime() + GRACE_NANOS);
+        return new ProcessResult(child.exitCode(), out.text(), err.text());
+      } catch (InterruptedException e) {
+        Thread.currentThread().interrupt();
+        child.killTree();
+        throw JobFailure.of(JobFailure.Kind.FAILED, e);
+      }
+    }
+  }
+
+  private static Thread daemon(Runnable task, String name) {
+    Thread thread = new Thread(task, name);
+    thread.setDaemon(true);
+    return thread;
+  }
+
+  private static void killAndCleanUp(Child child, Thread outThread, Thread errThread)
+      throws InterruptedException {
+    long deadline = System.nanoTime() + CLEANUP_BUDGET.toNanos();
+    child.killTree();
+    child.waitFor(Math.max(0, deadline - System.nanoTime()));
+    child.close();
+    join(outThread, deadline);
+    join(errThread, deadline);
+  }
+
+  private static void closeQuietly(Closeable stream) {
+    try {
+      stream.close();
+    } catch (IOException ignored) {
+      // Nothing left to do for a stream that will not close.
+    }
+  }
+
+  private static void join(Thread thread, long deadlineNanos) throws InterruptedException {
+    long left = deadlineNanos - System.nanoTime();
+    if (left > 0) {
+      thread.join(Math.max(1, TimeUnit.NANOSECONDS.toMillis(left)));
+    }
+  }
+}
diff --git a/src/main/java/com/video2podcast/media/FfmpegRunner.java b/src/main/java/com/video2podcast/media/FfmpegRunner.java
new file mode 100644
index 0000000..df852e8
--- /dev/null
+++ b/src/main/java/com/video2podcast/media/FfmpegRunner.java
@@ -0,0 +1,103 @@
+package com.video2podcast.media;
+
+import com.video2podcast.config.AppProperties;
+import com.video2podcast.job.JobFailure;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Turns a downloaded source into a 16 kHz mono WAV and cuts it into ten-minute chunks. */
+public class FfmpegRunner {
+
+  private static final Logger LOG = LoggerFactory.getLogger(FfmpegRunner.class);
+
+  private final ProcessRunner runner;
+  private final AppProperties.Jobs jobs;
+
+  public FfmpegRunner(ProcessRunner runner, AppProperties.Jobs jobs) {
+    this.runner = runner;
+    this.jobs = jobs;
+  }
+
+  /**
+   * Creates {@code audio.wav} (16 kHz, mono, pcm_s16le) in {@code jobDir} and returns it.
+   *
+   * @throws JobFailure FAILED or TIMEOUT
+   */
+  public Path toWav(Path source, Path jobDir) {
+    Path wav = jobDir.resolve("audio.wav");
+    try {
+      Files.deleteIfExists(wav);
+    } catch (IOException e) {
+      throw JobFailure.of(JobFailure.Kind.FAILED, e);
+    }
+    run(
+        List.of(
+            "ffmpeg",
+            "-nostdin",
+            "-hide_banner",
+            "-loglevel",
+            "error",
+            "-y",
+            "-i",
+            source.toString(),
+            "-vn",
+            "-ar",
+            "16000",
+            "-ac",
+            "1",
+            "-c:a",
+            "pcm_s16le",
+            wav.toString()));
+    if (!nonEmptyFile(wav)) {
+      throw JobFailure.of(JobFailure.Kind.FAILED);
+    }
+    return wav;
+  }
+
+  /**
+   * Splits {@code wav} into {@code <jobDir>/chunks/chunk-NNN.wav} of about ten minutes.
+   *
+   * @return the chunks in order
+   */
+  public List<Path> split(Path wav, Path jobDir) {
+    if (!Files.isRegularFile(wav)) {
+      throw JobFailure.of(JobFailure.Kind.FAILED);
+    }
+    Path chunksDir = jobDir.resolve("chunks");
+    try {
+      Files.createDirectories(chunksDir);
+    } catch (IOException e) {
+      throw JobFailure.of(JobFailure.Kind.FAILED, e);
+    }
+    ChunkSplitter.deleteExisting(chunksDir);
+    run(ChunkSplitter.splitArgs(wav, chunksDir));
+    List<Path> chunks = ChunkSplitter.collect(chunksDir);
+    if (chunks.isEmpty()) {
+      throw JobFailure.of(JobFailure.Kind.FAILED);
+    }
+    return chunks;
+  }
+
+  private void run(List<String> args) {
+    ProcessResult result = runner.run(args, jobs.ffmpegTimeout());
+    if (result.exitCode() != 0) {
+      String stderr = result.stderr() == null ? "" : result.stderr();
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("ffmpeg exited with {}: {}", result.exitCode(), YtDlpClient.forLog(stderr));
+      }
+      throw JobFailure.of(JobFailure.Kind.FAILED);
+    }
+  }
+
+  private static boolean nonEmptyFile(Path file) {
+    try {
+      return Files.isRegularFile(file) && Files.size(file) > 0;
+    } catch (IOException e) {
+      return false;
+    }
+  }
+}
