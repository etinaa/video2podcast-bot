+  private static com.github.tomakehurst.wiremock.WireMockServer startLoopbackServer() {
+    RuntimeException last = null;
+    for (int attempt = 0; attempt < 3; attempt++) {
+      com.github.tomakehurst.wiremock.WireMockServer server =
+          new com.github.tomakehurst.wiremock.WireMockServer(
+              com.github.tomakehurst.wiremock.core.WireMockConfiguration.wireMockConfig()
+                  .bindAddress("127.0.0.1")
+                  .dynamicPort());
+      try {
+        server.start();
+        return server;
+      } catch (RuntimeException e) {
+        try {
+          server.stop();
+        } catch (Exception cleanupFailure) {
+          e.addSuppressed(cleanupFailure);
+        }
+        if (!isBindFailure(e)) {
+          throw e;
+        }
+        last = e;
+      }
+    }
+    throw new IllegalStateException("no free port on 127.0.0.1", last);
+  }
+
+  private static boolean isBindFailure(Throwable error) {
+    for (Throwable t = error; t != null; t = t.getCause()) {
+      if (t instanceof java.net.BindException
+          || (t.getMessage() != null && t.getMessage().contains("Address already in use"))) {
+        return true;
+      }
+    }
+    return false;
+  }
