@@ -0,0 +1,53 @@
+package com.video2podcast.bot;
+
+import com.video2podcast.job.JobProgress;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Edits the status message of one job as it moves through the stages. */
+final class StatusReporter implements JobProgress {
+
+  private static final Logger LOG = LoggerFactory.getLogger(StatusReporter.class);
+
+  private final TelegramGateway gateway;
+  private final long chatId;
+  private final int messageId;
+  private String lastText;
+
+  StatusReporter(TelegramGateway gateway, long chatId, int messageId) {
+    this.gateway = gateway;
+    this.chatId = chatId;
+    this.messageId = messageId;
+  }
+
+  @Override
+  public void downloading() {
+    show("Downloading…");
+  }
+
+  @Override
+  public void transcribing(int n, int total) {
+    show("Transcribing " + n + "/" + total + "…");
+  }
+
+  @Override
+  public void summarizing() {
+    show("Summarizing…");
+  }
+
+  /** Telegram rejects an edit that changes nothing, so an equal text is not sent. */
+  private void show(String text) {
+    if (text.equals(lastText)) {
+      return;
+    }
+    lastText = text;
+    try {
+      gateway.editMessage(chatId, messageId, text, List.of());
+    } catch (RuntimeException e) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Could not edit the status message {}: {}", messageId, e.getMessage());
+      }
+    }
+  }
+}
diff --git a/src/main/java/com/video2podcast/bot/SummaryMessageFormatter.java b/src/main/java/com/video2podcast/bot/SummaryMessageFormatter.java
new file mode 100644
index 0000000..8c1cbf3
--- /dev/null
+++ b/src/main/java/com/video2podcast/bot/SummaryMessageFormatter.java
@@ -0,0 +1,53 @@
+package com.video2podcast.bot;
+
+/** Builds the HTML of the summary message. */
+final class SummaryMessageFormatter {
+
+  static final int TITLE_MAX = 200;
+
+  private static final String ELLIPSIS = "…";
+  private static final int SECONDS_PER_MINUTE = 60;
+  private static final int SECONDS_PER_HOUR = 3600;
+
+  private SummaryMessageFormatter() {}
+
+  /** {@code <b>title</b>\nDuration: 1h 42m\n\n• a\n• b} with title and bullets HTML-escaped. */
+  static String format(String title, long durationSeconds, String bullets) {
+    return "<b>"
+        + Html.escape(displayTitle(title))
+        + "</b>\nDuration: "
+        + formatDuration(durationSeconds)
+        + "\n\n"
+        + Html.escape(bullets);
+  }
+
+  /**
+   * Whitespace runs become one space, then strip, then cut to {@link #TITLE_MAX} UTF-16 units. A
+   * cut title ends with an ellipsis and is exactly that long, unless the cut would split a
+   * surrogate pair, in which case it is one unit shorter.
+   */
+  static String displayTitle(String title) {
+    String clean = title.replaceAll("\\s+", " ").strip();
+    if (clean.length() <= TITLE_MAX) {
+      return clean;
+    }
+    int end = TITLE_MAX - ELLIPSIS.length();
+    if (Character.isHighSurrogate(clean.charAt(end - 1))) {
+      end--;
+    }
+    return clean.substring(0, end) + ELLIPSIS;
+  }
+
+  /** {@code 1h 42m}, {@code 5m} or {@code 45s}; minutes are floored. */
+  static String formatDuration(long seconds) {
+    long hours = seconds / SECONDS_PER_HOUR;
+    long minutes = seconds % SECONDS_PER_HOUR / SECONDS_PER_MINUTE;
+    if (hours > 0) {
+      return hours + "h " + minutes + "m";
+    }
+    if (minutes > 0) {
+      return minutes + "m";
+    }
+    return seconds + "s";
+  }
+}
diff --git a/src/main/java/com/video2podcast/bot/SummaryMessagePublisher.java b/src/main/java/com/video2podcast/bot/SummaryMessagePublisher.java
new file mode 100644
index 0000000..8a046e3
--- /dev/null
+++ b/src/main/java/com/video2podcast/bot/SummaryMessagePublisher.java
@@ -0,0 +1,39 @@
+package com.video2podcast.bot;
+
+import com.video2podcast.job.JobRecord;
+import com.video2podcast.job.SummaryPublisher;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Sends the summary of a finished job through Telegram. */
+public class SummaryMessagePublisher implements SummaryPublisher {
+
+  private static final Logger LOG = LoggerFactory.getLogger(SummaryMessagePublisher.class);
+
+  private final TelegramGateway gateway;
+
+  public SummaryMessagePublisher(TelegramGateway gateway) {
+    this.gateway = gateway;
+  }
+
+  @Override
+  public int publish(JobRecord job, String summary) {
+    return gateway.sendMessage(job.chatId(), html(job, summary), Keyboards.delivery(job.jobId()));
+  }
+
+  @Override
+  public void withdraw(JobRecord job, int messageId, String summary) {
+    try {
+      gateway.editMessage(job.chatId(), messageId, html(job, summary), List.of());
+    } catch (RuntimeException e) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Could not take the buttons off the summary of job {}", job.jobId(), e);
+      }
+    }
+  }
+
+  private static String html(JobRecord job, String summary) {
+    return SummaryMessageFormatter.format(job.title(), job.durationSeconds(), summary);
+  }
+}
diff --git a/src/main/java/com/video2podcast/bot/UrlMessageHandler.java b/src/main/java/com/video2podcast/bot/UrlMessageHandler.java
new file mode 100644
index 0000000..3d7390f
--- /dev/null
+++ b/src/main/java/com/video2podcast/bot/UrlMessageHandler.java
@@ -0,0 +1,166 @@
+package com.video2podcast.bot;
+
+import com.video2podcast.job.JobFailure;
+import com.video2podcast.job.JobQueue;
+import com.video2podcast.job.JobRequest;
+import com.video2podcast.job.JobStore;
+import com.video2podcast.job.PipelineService;
+import com.video2podcast.media.UrlValidator;
+import java.time.Clock;
+import java.time.Duration;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.concurrent.atomic.AtomicReference;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Turns a link message of an allowed user into a queued job. The first message the user gets, which
+ * is also the acknowledgement, shows the queue position and is then edited through the stages.
+ */
+public class UrlMessageHandler {
+
+  private static final Logger LOG = LoggerFactory.getLogger(UrlMessageHandler.class);
+
+  private static final Duration STATUS_WAIT = Duration.ofSeconds(30);
+
+  private final TelegramGateway gateway;
+  private final UrlValidator validator;
+  private final JobQueue queue;
+  private final PipelineService pipeline;
+  private final Clock clock;
+  private final Duration statusWait;
+
+  public UrlMessageHandler(
+      TelegramGateway gateway,
+      UrlValidator validator,
+      JobQueue queue,
+      PipelineService pipeline,
+      Clock clock) {
+    this(gateway, validator, queue, pipeline, clock, STATUS_WAIT);
+  }
+
+  /** {@code statusWait} is how long a started job waits for its status message to exist. */
+  UrlMessageHandler(
+      TelegramGateway gateway,
+      UrlValidator validator,
+      JobQueue queue,
+      PipelineService pipeline,
+      Clock clock,
+      Duration statusWait) {
+    this.gateway = gateway;
+    this.validator = validator;
+    this.queue = queue;
+    this.pipeline = pipeline;
+    this.clock = clock;
+    this.statusWait = statusWait;
+  }
+
+  /** {@code text} is the whole message text; it is stripped here. */
+  void handle(Sender sender, String text) {
+    String url = text.strip();
+    try {
+      validator.validate(url);
+    } catch (JobFailure failure) {
+      tellFailure(sender.chatId(), failure);
+      return;
+    }
+    JobRequest request =
+        new JobRequest(JobStore.newJobId(), sender.userId(), sender.chatId(), url, clock.instant());
+    CompletableFuture<Integer> statusId = new CompletableFuture<>();
+    AtomicReference<JobFailure> failure = new AtomicReference<>();
+    CompletableFuture<Void> future;
+    try {
+      future = queue.submit(() -> runJob(request, statusId, failure));
+    } catch (RejectedExecutionException e) {
+      tellFailure(sender.chatId(), JobFailure.of(JobFailure.Kind.FAILED, e));
+      return;
+    }
+    int id;
+    try {
+      id = gateway.sendMessage(sender.chatId(), "Queued: position " + queue.size(), List.of());
+    } catch (RuntimeException e) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Could not send the queued message to chat {}", sender.chatId(), e);
+      }
+      statusId.completeExceptionally(e);
+      return;
+    }
+    statusId.complete(id);
+    future.whenCompleteAsync(
+        (result, error) -> finish(sender.chatId(), id, failure.get(), error),
+        Thread::startVirtualThread);
+  }
+
+  /** Runs on the worker thread. It never throws for an expected failure. */
+  private void runJob(
+      JobRequest request,
+      CompletableFuture<Integer> statusId,
+      AtomicReference<JobFailure> failure) {
+    int id;
+    try {
+      id = statusId.get(statusWait.toMillis(), TimeUnit.MILLISECONDS);
+    } catch (ExecutionException e) {
+      return;
+    } catch (TimeoutException e) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("No status message for job {} within {}", request.jobId(), statusWait);
+      }
+      failure.set(JobFailure.of(JobFailure.Kind.FAILED, e));
+      return;
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Interrupted while waiting for the status message of job {}", request.jobId());
+      }
+      failure.set(JobFailure.of(JobFailure.Kind.FAILED, e));
+      return;
+    }
+    try {
+      pipeline.run(request, new StatusReporter(gateway, request.chatId(), id));
+    } catch (JobFailure f) {
+      failure.set(f);
+    } catch (RuntimeException e) {
+      if (LOG.isErrorEnabled()) {
+        LOG.error("Job {} failed unexpectedly", request.jobId(), e);
+      }
+      failure.set(JobFailure.of(JobFailure.Kind.FAILED, e));
+    }
+  }
+
+  /** Runs after the job has left the queue. Every Telegram problem is logged and dropped. */
+  private void finish(long chatId, int statusId, JobFailure failure, Throwable error) {
+    JobFailure outcome =
+        failure == null && error != null ? JobFailure.of(JobFailure.Kind.FAILED, error) : failure;
+    if (outcome == null) {
+      editStatus(chatId, statusId, "Done.");
+    } else {
+      tellFailure(chatId, outcome);
+      editStatus(chatId, statusId, "Failed.");
+    }
+  }
+
+  private void tellFailure(long chatId, JobFailure failure) {
+    try {
+      gateway.sendMessage(chatId, Html.escape(failure.getMessage()), List.of());
+    } catch (RuntimeException e) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Could not send a failure message to chat {}", chatId, e);
+      }
+    }
+  }
+
+  private void editStatus(long chatId, int statusId, String text) {
+    try {
+      gateway.editMessage(chatId, statusId, text, List.of());
+    } catch (RuntimeException e) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Could not edit the status message {} in chat {}", statusId, chatId, e);
+      }
+    }
+  }
+}
