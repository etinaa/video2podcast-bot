+    assertThat(
+            w.calls("sendMessage").stream()
+                .filter(e -> e.text().equals(s) && e.nanos() >= w.lastUpdateNanos))
+        .hasSize(1);
+  }
+
+  @Then("the Telegram mock receives exactly one {string} edit attempt")
+  public void oneEdit(String s) {
+    w.done();
