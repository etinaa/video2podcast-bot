+                    .toList())
+            .hasSize(1));
+    Event acknowledgement =
+        w.calls("sendMessage").stream()
+            .filter(e -> e.text().startsWith("Queued:") && e.nanos() >= w.lastUpdateNanos)
+            .findFirst()
+            .orElseThrow();
