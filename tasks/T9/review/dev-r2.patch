+++ b/src/main/java/com/video2podcast/transcript/TranscriptMerger.java
@@ -0,0 +1,40 @@
+package com.video2podcast.transcript;
+
+import java.util.List;
+import java.util.regex.Pattern;
+
+/** Joins the texts of the chunks into one plain-text transcript. */
+final class TranscriptMerger {
+
+  private static final Pattern WHITESPACE =
+      Pattern.compile("[\\s\\u00A0]+", Pattern.UNICODE_CHARACTER_CLASS);
+
+  private TranscriptMerger() {}
+
+  /** Trims and collapses every run of whitespace to one space; null gives an empty string. */
+  static String normalize(String text) {
+    if (text == null) {
+      return "";
+    }
+    return WHITESPACE.matcher(text).replaceAll(" ").strip();
+  }
+
+  /** Normalized, non-empty texts joined by one space plus one newline; "" if nothing is left. */
+  static String merge(List<String> texts) {
+    StringBuilder out = new StringBuilder();
+    for (String text : texts) {
+      String normalized = normalize(text);
+      if (normalized.isEmpty()) {
+        continue;
+      }
+      if (!out.isEmpty()) {
+        out.append(' ');
+      }
+      out.append(normalized);
+    }
+    if (out.isEmpty()) {
+      return "";
+    }
+    return out.append('\n').toString();
+  }
+}
diff --git a/src/main/java/com/video2podcast/transcript/TranscriptionClient.java b/src/main/java/com/video2podcast/transcript/TranscriptionClient.java
new file mode 100644
index 0000000..aa97eab
--- /dev/null
+++ b/src/main/java/com/video2podcast/transcript/TranscriptionClient.java
@@ -0,0 +1,112 @@
+package com.video2podcast.transcript;
+
+import com.video2podcast.job.JobFailure;
+import com.video2podcast.storage.AtomicFiles;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.stream.Stream;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Turns the WAV chunks of a job into {@code transcript.txt} through whisper-server. */
+public class TranscriptionClient {
+
+  private static final Logger LOG = LoggerFactory.getLogger(TranscriptionClient.class);
+
+  private final WhisperClient whisper;
+
+  public TranscriptionClient(WhisperClient whisper) {
+    this.whisper = whisper;
+  }
+
+  /**
+   * Transcribes {@code chunks} in order and writes {@code <jobDir>/transcript.txt}. On success
+   * deletes {@code <jobDir>/audio.wav} and {@code <jobDir>/chunks/}; keeps source.*.
+   *
+   * @param progress called as accept(n, total) before chunk n is first sent (n from 1), once per
+   *     chunk, not again on the retry
+   * @return the path of transcript.txt
+   * @throws NullPointerException if an argument is null
+   * @throws JobFailure NO_SPEECH, SERVICE_UNREACHABLE or FAILED
+   */
+  public Path transcribe(Path jobDir, List<Path> chunks, ProgressListener progress) {
+    Objects.requireNonNull(jobDir, "jobDir");
+    Objects.requireNonNull(chunks, "chunks");
+    Objects.requireNonNull(progress, "progress");
+    if (chunks.isEmpty() || !Files.isDirectory(jobDir)) {
+      throw JobFailure.transcriptionFailed(null);
+    }
+    List<String> texts = new ArrayList<>(chunks.size());
+    int total = chunks.size();
+    for (int i = 0; i < total; i++) {
+      progress.accept(i + 1, total);
+      texts.add(transcribeWithRetry(chunks.get(i)));
+    }
+    String merged = TranscriptMerger.merge(texts);
+    if (merged.isEmpty()) {
+      throw JobFailure.of(JobFailure.Kind.NO_SPEECH);
+    }
+    Path transcript = jobDir.resolve("transcript.txt");
+    try {
+      AtomicFiles.write(transcript, merged.getBytes(StandardCharsets.UTF_8));
+    } catch (IOException e) {
+      throw JobFailure.transcriptionFailed(e);
+    }
+    deleteTemporaryAudio(jobDir);
+    return transcript;
+  }
+
+  private String transcribeWithRetry(Path chunk) {
+    try {
+      return whisper.transcribe(chunk);
+    } catch (WhisperException first) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Chunk {} failed, retrying: {}", chunk.getFileName(), first.getMessage());
+      }
+    }
+    try {
+      return whisper.transcribe(chunk);
+    } catch (WhisperException second) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Chunk {} failed again: {}", chunk.getFileName(), second.getMessage());
+      }
+      if (second.isConnection()) {
+        throw JobFailure.of(JobFailure.Kind.SERVICE_UNREACHABLE, second);
+      }
+      throw JobFailure.transcriptionFailed(second);
+    }
+  }
+
+  private static void deleteTemporaryAudio(Path jobDir) {
+    delete(jobDir.resolve("audio.wav"));
+    Path chunkDir = jobDir.resolve("chunks");
+    try (Stream<Path> files = Files.list(chunkDir)) {
+      files.forEach(TranscriptionClient::delete);
+    } catch (IOException e) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Could not list {}: {}", chunkDir.getFileName(), e.getClass().getSimpleName());
+      }
+    }
+    delete(chunkDir);
+  }
+
+  private static void delete(Path file) {
+    try {
+      Files.deleteIfExists(file);
+    } catch (IOException e) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Could not delete {}: {}", file.getFileName(), e.getClass().getSimpleName());
+      }
+    }
+  }
+
+  @FunctionalInterface
+  public interface ProgressListener {
+    void accept(int n, int total);
+  }
+}
diff --git a/src/main/java/com/video2podcast/transcript/WhisperClient.java b/src/main/java/com/video2podcast/transcript/WhisperClient.java
new file mode 100644
index 0000000..4f7cb07
--- /dev/null
+++ b/src/main/java/com/video2podcast/transcript/WhisperClient.java
@@ -0,0 +1,147 @@
+package com.video2podcast.transcript;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.video2podcast.config.AppProperties;
+import com.video2podcast.storage.Json;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.net.ConnectException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpConnectTimeoutException;
+import java.net.http.HttpRequest;
+import java.net.http.HttpRequest.BodyPublisher;
+import java.net.http.HttpRequest.BodyPublishers;
+import java.net.http.HttpResponse;
+import java.net.http.HttpResponse.BodyHandlers;
+import java.net.http.HttpTimeoutException;
+import java.nio.channels.UnresolvedAddressException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.UUID;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** One call to the whisper.cpp server: sends a WAV chunk and returns the recognized text. */
+public class WhisperClient {
+
+  private static final Logger LOG = LoggerFactory.getLogger(WhisperClient.class);
+  private static final Duration CONNECT_TIMEOUT = Duration.ofSeconds(5);
+  private static final int LOGGED_BODY_CHARS = 200;
+
+  private final HttpClient http;
+  private final URI endpoint;
+  private final Duration timeout;
+
+  public WhisperClient(AppProperties.Whisper config) {
+    this(
+        config,
+        HttpClient.newBuilder()
+            .connectTimeout(CONNECT_TIMEOUT)
+            .followRedirects(HttpClient.Redirect.NEVER)
+            .build());
+  }
+
+  /** For tests: the transport is supplied. */
+  WhisperClient(AppProperties.Whisper config, HttpClient http) {
+    String base = config.baseUrl();
+    String trimmed = base.endsWith("/") ? base.substring(0, base.length() - 1) : base;
+    this.endpoint = URI.create(trimmed + "/inference");
+    this.timeout = config.timeout();
+    this.http = http;
+  }
+
+  /** For tests: the transport the requests go through. */
+  HttpClient httpClient() {
+    return http;
+  }
+
+  /** Returns the raw "text" field of the answer, not normalized. */
+  public String transcribe(Path chunk) throws WhisperException {
+    String boundary = "----v2p" + UUID.randomUUID().toString().replace("-", "");
+    HttpResponse<String> response = send(chunk, boundary);
+    int status = response.statusCode();
+    if (status < 200 || status > 299) {
+      if (LOG.isWarnEnabled()) {
+        LOG.warn("Whisper answered {}: {}", status, abbreviate(response.body()));
+      }
+      throw new WhisperException("Whisper answered status " + status, false, null);
+    }
+    return textOf(response.body());
+  }
+
+  private HttpResponse<String> send(Path chunk, String boundary) throws WhisperException {
+    try {
+      HttpRequest request =
+          HttpRequest.newBuilder(endpoint)
+              .timeout(timeout)
+              .header("Content-Type", "multipart/form-data; boundary=" + boundary)
+              .POST(body(chunk, boundary))
+              .build();
+      return http.send(request, BodyHandlers.ofString(StandardCharsets.UTF_8));
+    } catch (HttpConnectTimeoutException | ConnectException | UnresolvedAddressException e) {
+      throw new WhisperException("No connection to Whisper", true, e);
+    } catch (HttpTimeoutException e) {
+      throw new WhisperException("Whisper did not answer in time", false, e);
+    } catch (IOException e) {
+      throw new WhisperException("Whisper request failed", false, e);
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+      throw new WhisperException("Whisper request interrupted", false, e);
+    }
+  }
+
+  private static BodyPublisher body(Path chunk, String boundary) throws FileNotFoundException {
+    String head =
+        "--"
+            + boundary
+            + "\r\nContent-Disposition: form-data; name=\"file\"; filename=\""
+            + chunk.getFileName()
+            + "\"\r\nContent-Type: audio/wav\r\n\r\n";
+    String tail =
+        field(boundary, "response_format", "json")
+            + field(boundary, "language", "en")
+            + field(boundary, "temperature", "0.0")
+            + "--"
+            + boundary
+            + "--\r\n";
+    return BodyPublishers.concat(
+        BodyPublishers.ofString(head, StandardCharsets.UTF_8),
+        BodyPublishers.ofFile(chunk),
+        BodyPublishers.ofString("\r\n" + tail, StandardCharsets.UTF_8));
+  }
+
+  private static String field(String boundary, String name, String value) {
+    return "--"
+        + boundary
+        + "\r\nContent-Disposition: form-data; name=\""
+        + name
+        + "\"\r\n\r\n"
+        + value
+        + "\r\n";
+  }
+
+  private static String textOf(String body) throws WhisperException {
+    if (body == null || body.isBlank()) {
+      throw new WhisperException("Whisper answered with an empty body", false, null);
+    }
+    JsonNode text;
+    try {
+      text = Json.MAPPER.readTree(body).path("text");
+    } catch (IOException e) {
+      throw new WhisperException("Whisper answer is not JSON", false, e);
+    }
+    if (!text.isTextual()) {
+      throw new WhisperException("Whisper answer has no text", false, null);
+    }
+    return text.textValue();
+  }
+
+  private static String abbreviate(String body) {
+    if (body == null) {
+      return "";
+    }
+    return body.length() <= LOGGED_BODY_CHARS ? body : body.substring(0, LOGGED_BODY_CHARS);
+  }
+}
