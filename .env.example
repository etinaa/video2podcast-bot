# Copy to .env and fill in. .env is ignored by git; never commit real values.
# Used by ./run.sh and by `podman compose` (env_file). Variables left commented out use the default
# shown, which is the one from src/main/resources/application.yml (in the container).

# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (send /whoami to the bot to find it)
ADMIN_USER_ID=

# Set to false to start without the Telegram connection (tests and diagnostics)
# TELEGRAM_ENABLED=true
# Base URL of the Telegram Bot API; empty means the official cloud API
# TELEGRAM_API_URL=

# File with the allowed users (the /data volume in the container)
# ACCESS_FILE=/data/allowed-users.json
# Minimum time between two access requests from the same user (ISO-8601 duration)
# ACCESS_REQUEST_COOLDOWN=PT24H

# Ollama on the host
# OLLAMA_BASE_URL=http://host.containers.internal:11434
# OLLAMA_MODEL=qwen3:32b
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT=PT10M

# whisper-server on the host
# WHISPER_BASE_URL=http://host.containers.internal:8081
# WHISPER_TIMEOUT=PT10M

# Service check at startup and before every job (how long one probe may take)
# HEALTH_TIMEOUT=PT3S

# Job working directory (the /work volume in the container)
# WORK_DIR=/work
# MAX_VIDEO_DURATION=PT3H
# JOB_RETENTION=PT1H
# METADATA_TIMEOUT=PT1M
# DOWNLOAD_TIMEOUT=PT30M
# FFMPEG_TIMEOUT=PT30M
# JOB_SWEEP_INTERVAL=PT1M
