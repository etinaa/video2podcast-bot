<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Approved by the owner (A: Q-developer-3 in tasks/T8/comms/questions.md). To be removed under
       TD1 in tasks/todo.md. DefaultProcessRunner starts yt-dlp and ffmpeg from an argument list
       (no shell); URLs pass UrlValidator and follow the end-of-options marker. find-sec-bugs
       flags any non-constant argument, and a typed command did not change that. -->
  <Match>
    <Class name="~com\.video2podcast\.media\.DefaultProcessRunner(\$Child)?"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>
  <!-- Approved by the owner (D10 in docs/decisions.md; A: Q-developer-1 in
       tasks/T11/comms/questions.md). PipelineService keeps a JobStore, a shared service and not a
       value object. SpotBugs calls JobStore mutable only because a method is named delete. -->
  <Match>
    <Class name="com.video2podcast.job.PipelineService"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
